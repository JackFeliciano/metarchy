[Unit]
Description=Metarchy governance register
After=network.target

[Service]
Type=simple
User=opc
Group=opc
WorkingDirectory=/srv/metarchy
Environment=METARCHY_BASE=/metarchy/
ExecStart=/usr/bin/php -S 127.0.0.1:8106 -t showroom showroom/index.php
Restart=on-failure
RestartSec=2

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/metarchy
MemoryDenyWriteExecute=false

[Install]
WantedBy=multi-user.target
